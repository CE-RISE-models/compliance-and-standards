comp:ValidityPeriod a owl:Class ;
    rdfs:label "ValidityPeriod" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty comp:end_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty comp:start_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty comp:is_perpetual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty comp:end_date ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty comp:start_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty comp:start_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty comp:end_date ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty comp:is_perpetual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty comp:is_perpetual ] ;
    skos:definition "Time period during which something is valid" ;
    skos:inScheme comp: ;
    comp:owl.filler "time:Interval" ;
    comp:sql_identifier "comp_validity_period" .

