    skos:definition "Current status in this jurisdiction" ;
    skos:inScheme comp: ;
    comp:sql_identifier "comp_status_value" .

comp:storage_conditions a owl:DatatypeProperty ;
    rdfs:label "storage_conditions" ;
    skos:definition "Storage conditions" ;
    skos:inScheme comp: ;
    comp:owl.filler "schema:storageRequirements" ;
