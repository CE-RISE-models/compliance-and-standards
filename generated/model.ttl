    comp:sql_identifier "comp_mgmt_type" .

comp:target_date a owl:DatatypeProperty ;
    rdfs:label "target_date" ;
    skos:definition "Target achievement date" ;
    skos:inScheme comp: ;
    comp:owl.filler "schema:targetDate" ;
    comp:sql_identifier "comp_target_date" .

comp:target_description a owl:DatatypeProperty ;
    rdfs:label "target_description" ;
    skos:definition "Description of target" ;
    skos:inScheme comp: ;
    comp:owl.filler "dcterms:description" ;
    comp:sql_identifier "comp_target_desc" .

comp:target_value a owl:DatatypeProperty ;
    rdfs:label "target_value" ;
    skos:definition "Target value" ;
