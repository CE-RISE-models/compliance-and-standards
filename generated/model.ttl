        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty comp:amendment_type ] ;
    skos:definition "Record of an amendment to a requirement" ;
    skos:inScheme comp: ;
    comp:owl.filler "prov:Revision" ;
    comp:sql_identifier "comp_amendment" .

comp:ApplicabilityStatus a owl:Class ;
