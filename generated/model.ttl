comp:amendment_history a owl:ObjectProperty ;
    rdfs:label "amendment_history" ;
    skos:definition "History of amendments to this requirement" ;
    skos:inScheme comp: ;
    comp:sql_identifier "comp_req_amendments" .

comp:applicability_statuses a owl:ObjectProperty ;
    rdfs:label "applicability_statuses" ;
    skos:definition "Status of this requirement in different jurisdictions" ;
    skos:inScheme comp: ;
    comp:sql_identifier "comp_req_app_statuses" .

comp:applicable_jurisdictions a owl:DatatypeProperty ;
    rdfs:label "applicable_jurisdictions" ;
    skos:definition "Jurisdictions where this applies" ;
    skos:inScheme comp: ;
    comp:owl.filler "schema:addressCountry" ;
    comp:references "ESPR Annex III; CIRPASS" ;
    comp:sql_identifier "comp_safety_jurisdictions" .

comp:applicable_markets a owl:DatatypeProperty ;
    rdfs:label "applicable_markets" ;
    skos:definition "Markets or regions where this commitment applies" ;
    skos:inScheme comp: ;
    comp:owl.filler "schema:areaServed" ;
    comp:sql_identifier "comp_scope_markets" .

comp:applicable_standards a owl:DatatypeProperty ;
    rdfs:label "applicable_standards" ;
    skos:definition "Standards this statement relates to" ;
    skos:inScheme comp: ;
    comp:owl.filler "dcterms:conformsTo" ;
    comp:sql_identifier "comp_statement_standards" .

comp:audit_data_quality_assessments a owl:ObjectProperty ;
    rdfs:label "audit_data_quality_assessments" ;
    skos:definition "Optional data quality assessments for audit findings, corrective action evidence, audit scope, auditor provenance, or result reliability" ;
    skos:inScheme comp: ;
    comp:owl.filler "dqf:dataQualityAssessment" ;
    comp:sql_identifier "comp_audit_data_quality_assessments" .

comp:audit_history a owl:ObjectProperty ;
    rdfs:label "audit_history" ;
    skos:definition "Audit history records" ;
    skos:inScheme comp: ;
    comp:sql_identifier "comp_mgmt_audits" .

comp:audit_records a owl:DatatypeProperty ;
    rdfs:label "audit_records" ;
    skos:definition "References to audit records" ;
    skos:inScheme comp: ;
    comp:owl.filler "prov:wasInfluencedBy" ;
    comp:sql_identifier "comp_evid_ref_audits" .

comp:batch_lot_identifiers a owl:DatatypeProperty ;
    rdfs:label "batch_lot_identifiers" ;
    skos:definition "Batch or lot numbers covered by this evidence (for materials tracked at batch level)" ;
    skos:inScheme comp: ;
    comp:comment "Batch/lot tracking per ISO 22000 traceability requirements" ;
    comp:owl.filler "bfo:BFO_0000040" ;
