        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mt:traceability_evidence_reference_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mt:assigned_value_value ],
        [ a owl:Restriction ;
