<https://ce-rise-models.codeberg.page/compliance-and-standards/.owl.ttl> a owl:Ontology ;
    rdfs:label "compliance_and_standards" ;
    dcterms:license "https://creativecommons.org/licenses/by-nc/4.0/" ;
    dcterms:title "CE-RISE Compliance and Standards Data Model" ;
    pav:version "0.1.0" ;
    skos:definition "Data model for regulatory compliance, standards, and conformity-related information for products and materials, including applicable regulations and standards, commitments, documentary evidence, process evidence, and structured regulatory information sheets. Supports both Digital Product Passports (DPP) and Digital Material Passports (DMP)." .

comp:ComplianceAndStandards a owl:Class ;
    rdfs:label "ComplianceAndStandards" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty comp:entity_evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty comp:entity_commitments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty comp:entity_commitments ],
        [ a owl:Restriction ;
            owl:allValuesFrom comp:EntityEvidence ;
            owl:onProperty comp:entity_evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty comp:applicable_regulation_standards ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty comp:regulatory_information ],
        [ a owl:Restriction ;
            owl:allValuesFrom comp:ApplicableRegulationStandards ;
            owl:onProperty comp:applicable_regulation_standards ],
        [ a owl:Restriction ;
            owl:allValuesFrom comp:EntityCommitments ;
            owl:onProperty comp:entity_commitments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty comp:applicable_regulation_standards ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty comp:entity_evidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty comp:process_evidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom comp:RegulatoryInformation ;
            owl:onProperty comp:regulatory_information ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty comp:regulatory_information ],
        [ a owl:Restriction ;
            owl:allValuesFrom comp:ProcessEvidence ;
            owl:onProperty comp:process_evidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty comp:process_evidence ] ;
    skos:definition "Root container for all compliance and standards related information for products and materials, encompassing commitments, requirements, evidence, and regulatory data." ;
    skos:inScheme comp: ;
    comp:sql_identifier "comp_root" .

dqf:DataQualityFramework a owl:Class ;
    rdfs:label "DataQualityFramework" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty dqf:quality_diagnostics ],
        [ a owl:Restriction ;
            owl:allValuesFrom dqf:UncertaintyTranslation ;
            owl:onProperty dqf:uncertainty_translations ],
        [ a owl:Restriction ;
