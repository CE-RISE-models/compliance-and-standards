        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mt:assigned_value_uncertainty_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty mt:reference_entity_identifier_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mt:reference_entity_uri_value ],
        [ a owl:Restriction ;
