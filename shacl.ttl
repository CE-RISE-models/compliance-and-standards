@prefix comp: <https://ce-rise-models.codeberg.page/compliance-and-standards/> .
@prefix dqf: <https://ce-rise-models.codeberg.page/data-quality-framework/> .
@prefix mt: <https://ce-rise-models.codeberg.page/metrological-traceability/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix uq: <https://ce-rise-models.codeberg.page/uncertainty-quantification/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

comp:ComplianceAndStandards a sh:NodeShape ;
    rdfs:comment "Root container for all compliance and standards related information for products and materials, encompassing commitments, requirements, evidence, and regulatory data." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class comp:RegulatoryInformation ;
            sh:description "Structured regulatory information including safety, instructions, and identifiers" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path comp:regulatory_information ],
        [ sh:class comp:EntityCommitments ;
            sh:description "All commitments for products or materials (regulatory, voluntary, contractual)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path comp:entity_commitments ],
        [ sh:class comp:EntityEvidence ;
            sh:description "Documentary evidence supporting compliance claims for products or materials" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path comp:entity_evidence ],
        [ sh:class comp:ProcessEvidence ;
            sh:description "Management system and process-related evidence" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path comp:process_evidence ],
        [ sh:class comp:ApplicableRegulationStandards ;
            sh:description "Applicable regulations, standards, and specifications" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path comp:applicable_regulation_standards ] ;
    sh:targetClass comp:ComplianceAndStandards .

dqf:dataQualityFramework a sh:NodeShape ;
    rdfs:comment "Root container for data quality assessments and supporting records" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dqf:qualityDiagnostic ;
            sh:description "Data-quality diagnostic runs, checks, or analyses" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path dqf:quality_diagnostics ],
        [ sh:class dqf:evidenceReference ;
            sh:description "Evidence records referenced by the data quality framework" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path dqf:data_quality_evidence_references ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Reusable data quality assessments that can be embedded or referenced by other CE-RISE data models" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dqf:data_quality_assessments ],
        [ sh:class dqf:qualityIssue ;
            sh:description "Data quality issues, limitations, anomalies, or risks" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path dqf:quality_issues ],
        [ sh:class dqf:uncertaintyTranslation ;
            sh:description "Translations from data quality scores to uncertainty information" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path dqf:uncertainty_translations ],
        [ sh:class dqf:remediationAction ;
            sh:description "Remediation, mitigation, containment, or improvement actions" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path dqf:remediation_actions ],
        [ sh:class dqf:qualityCriterionAssessment ;
            sh:description "Criterion-level pedigree assessments" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dqf:criterion_assessments ],
        [ sh:class dqf:qualityMetric ;
            sh:description "Quality metrics or diagnostic metrics used by profiles, criteria, or diagnostics" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dqf:quality_metrics ],
        [ sh:class dqf:dataQualityProfile ;
            sh:description "Data quality profiles available for reuse by one or more assessments" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path dqf:data_quality_profiles ],
        [ sh:class dqf:dataCharacterization ;
            sh:description "Data characterization records available for reuse by one or more assessments" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dqf:data_characterizations ],
        [ sh:class dqf:qualityAggregation ;
            sh:description "Aggregations of data quality assessments, profiles, criteria, metrics, or uncertainty translations" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path dqf:quality_aggregations ] ;
    sh:targetClass dqf:dataQualityFramework .

mt:metrologicalTraceability a sh:NodeShape ;
    rdfs:comment "Root container for metrological traceability statements and supporting records" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class mt:competenceRecord ;
            sh:description "Competence, accreditation, validation, or quality system records supporting traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path mt:competence_records ],
        [ sh:class mt:referenceMaterial ;
            sh:description "Reference materials and certified reference materials used in traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path mt:reference_materials ],
        [ sh:class mt:referenceEntity ;
            sh:description "Reference entities, standards, methods, instruments, datasets, or organizations used in traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path mt:reference_entities ],
        [ sh:class mt:traceabilityBasis ;
            sh:description "Reference bases used to establish metrological traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path mt:traceability_bases ],
        [ sh:class mt:measurementStandard ;
            sh:description "Measurement standards, artefacts, instruments, and realizations used in traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path mt:measurement_standards ],
        [ sh:class mt:traceabilityChain ;
            sh:description "Traceability chains or networks available for reuse by one or more traceability statements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path mt:traceability_chains ],
        [ sh:class mt:measurementProcedure ;
            sh:description "Measurement, calculation, sampling, calibration, analytical, or modelling procedures used for traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path mt:measurement_procedures ],
        [ sh:class mt:evidenceReference ;
            sh:description "Evidence records referenced by the metrological traceability model" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path mt:traceability_evidence_references ],
        [ sh:class mt:calibrationRecord ;
            sh:description "Calibration, comparison, verification, or check records that support traceability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path mt:calibration_records ],
        [ sh:class mt:traceabilityStatement ;
            sh:description "Reusable traceability statements that can be embedded or referenced by other CE-RISE data models" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path mt:traceability_statements ],
        [ sh:class mt:boundaryDefinition ;
            sh:description "Boundary, goal-and-scope, scenario, or model definitions used as traceability references" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path mt:boundary_definitions ],
        [ sh:class mt:comparabilityAssessment ;
            sh:description "Assessments of whether traceability statements support meaningful comparison" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path mt:comparability_assessments ] ;
    sh:targetClass mt:metrologicalTraceability .

uq:uncertaintyQuantification a sh:NodeShape ;
    rdfs:comment "Root container for uncertainty quantification statements and supporting records" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class uq:comparisonAssessment ;
            sh:description "Assessments of whether uncertainty statements support meaningful comparison" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path uq:comparison_assessments ],
        [ sh:class uq:uncertaintyStatement ;
            sh:description "Reusable uncertainty statements that can be embedded or referenced by other CE-RISE data models" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path uq:uncertainty_statements ],
        [ sh:class uq:propagationAnalysis ;
            sh:description "Propagation analyses available for reuse by one or more uncertainty statements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path uq:propagation_analyses ],
        [ sh:class uq:methodReference ;
            sh:description "Methods, standards, and protocols referenced by the uncertainty model" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path uq:method_references ],
        [ sh:class uq:uncertaintyBudget ;
            sh:description "Uncertainty budgets available for reuse by one or more uncertainty statements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path uq:uncertainty_budgets ],
        [ sh:class uq:evidenceReference ;
            sh:description "Evidence records referenced by the uncertainty model" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path uq:uncertainty_evidence_references ] ;
    sh:targetClass uq:uncertaintyQuantification .

comp:Amendment a sh:NodeShape ;
    rdfs:comment "Record of an amendment to a requirement" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Amendment identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:amendment_id ],
        [ sh:datatype <xsd:string> ;
            sh:description "Description of changes" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:amendment_description ],
        [ sh:datatype <xsd:string> ;
            sh:description "Type of amendment (correction, supplement, revision)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:amendment_type ],
        [ sh:datatype <xsd:date> ;
            sh:description "Date of amendment" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:amendment_date ] ;
    sh:targetClass comp:Amendment .

comp:ApplicabilityStatus a sh:NodeShape ;
    rdfs:comment "Jurisdiction-specific applicability status for a requirement, allowing tracking of how requirements apply differently across markets." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:date> ;
            sh:description "Date when this status ends or changes" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:end_date ],
        [ sh:datatype <xsd:string> ;
            sh:description "Transition period details if applicable" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path comp:transition_period ],
        [ sh:datatype <xsd:string> ;
            sh:description "Any derogations or exemptions" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path comp:derogations ],
        [ sh:datatype <xsd:string> ;
            sh:description "Level of enforcement in this jurisdiction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path comp:enforcement_level ],
        [ sh:datatype <xsd:date> ;
            sh:description "Date when this status becomes effective" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:effective_date ],
        [ sh:description "Status in this jurisdiction" ;
            sh:in ( "MANDATORY" "PRESUMPTION_OF_CONFORMITY" "RECOMMENDED" "VOLUNTARY" "SUPERSEDED" "WITHDRAWN" "DRAFT" "UNDER_REVIEW" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path comp:status ],
        [ sh:datatype <xsd:string> ;
            sh:description "Jurisdiction where this status applies" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:jurisdiction ] ;
    sh:targetClass comp:ApplicabilityStatus .

comp:ApplicableRegulationStandards a sh:NodeShape ;
    rdfs:comment "Container for all applicable regulations, standards, and specifications with jurisdiction-aware requirements tracking and version management." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class comp:RequirementEntry ;
            sh:description "List of applicable requirements (regulations, standards, specifications)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path comp:requirement_entries ] ;
    sh:targetClass comp:ApplicableRegulationStandards .

comp:AuditRecord a sh:NodeShape ;
    rdfs:comment "Record of an audit" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for audit findings, corrective action evidence, audit scope, auditor provenance, or result reliability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path comp:audit_data_quality_assessments ],
        [ sh:description "Type of audit" ;
            sh:in ( "INITIAL" "SURVEILLANCE" "RECERTIFICATION" "SPECIAL" "INTERNAL" "CUSTOMER" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path comp:audit_type ],
        [ sh:datatype <xsd:date> ;
            sh:description "Date of audit" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:audit_date ],
        [ sh:datatype <xsd:string> ;
            sh:description "Audit findings" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:findings ],
        [ sh:datatype <xsd:string> ;
            sh:description "Corrective actions taken" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:corrective_actions ],
        [ sh:datatype <xsd:string> ;
            sh:description "Overall audit result" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path comp:audit_result ],
        [ sh:datatype <xsd:string> ;
            sh:description "Auditor or audit organization" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path comp:auditor ] ;
    sh:targetClass comp:AuditRecord .

comp:CertificationDetails a sh:NodeShape ;
    rdfs:comment "Details about management system certification" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Name of certification body" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:certification_body ],
        [ sh:datatype <xsd:string> ;
            sh:description "Accreditation details of certification body" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path comp:accreditation_details ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for certification status, certification body accreditation, certificate validity, or evidence completeness" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path comp:certification_data_quality_assessments ],
        [ sh:class comp:ValidityPeriod ;
            sh:description "Validity period of certification" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path comp:validity_period ],
        [ sh:datatype <xsd:string> ;
            sh:description "Certificate number" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:certificate_number ],
        [ sh:description "Current certification status" ;
            sh:in ( "CERTIFIED" "PENDING" "EXPIRED" "SUSPENDED" "WITHDRAWN" "IN_PROGRESS" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path comp:certification_status ] ;
    sh:targetClass comp:CertificationDetails .

comp:Commitment a sh:NodeShape ;
    rdfs:comment "A single commitment representing any type of obligation for a product or material, including compliance requirements with flexible categorization and jurisdiction-specific status tracking." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class comp:ComplianceStatus ;
            sh:description "Status of this commitment in different jurisdictions" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path comp:compliance_statuses ],
        [ sh:class comp:EvidenceReferences ;
            sh:description "References to supporting evidence for this commitment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path comp:evidence_references ],
        [ sh:datatype <xsd:string> ;
            sh:description "Unique identifier for this commitment" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:commitment_identifier ],
        [ sh:datatype <xsd:string> ;
            sh:description "Version tracking for this commitment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path comp:version_info ],
        [ sh:class comp:ValidityPeriod ;
            sh:description "Period during which this commitment is valid" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path comp:validity_period ],
        [ sh:datatype <xsd:string> ;
            sh:description "The actual commitment statement or text" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:commitment_statement_value ],
        [ sh:class comp:CommitmentCategory ;
            sh:description "Categories this commitment belongs to (can be multiple)" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path comp:commitment_categories ],
        [ sh:datatype <xsd:dateTime> ;
            sh:description "Last update timestamp for this commitment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path comp:last_updated ],
        [ sh:datatype <xsd:string> ;
            sh:description "Detailed description or context of the commitment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:commitment_description ],
        [ sh:class comp:StakeholderScope ;
            sh:description "Scope of applicability for this commitment" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path comp:stakeholder_scope ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for commitment evidence, provenance, legal-source mapping, or completeness" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path comp:commitment_data_quality_assessments ] ;
    sh:targetClass comp:Commitment .

comp:CommitmentCategory a sh:NodeShape ;
    rdfs:comment "Category or type of commitment with external standard references" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:integer> ;
            sh:description "Priority or importance level of this category" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:priority_level ],
        [ sh:datatype <xsd:string> ;
            sh:description "External ontology or standard reference for this category" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:category_reference ],
        [ sh:description "Type of commitment category" ;
            sh:in ( "REGULATORY" "VOLUNTARY" "CONTRACTUAL" "INDUSTRY_STANDARD" "CUSTOMER_REQUIREMENT" "ENVIRONMENTAL" "SOCIAL" "QUALITY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path comp:category_type ] ;
    sh:targetClass comp:CommitmentCategory .

comp:ComplianceStatement a sh:NodeShape ;
    rdfs:comment "A regulatory compliance statement" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Jurisdictions where valid" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path comp:valid_for_jurisdictions ],
        [ sh:class uq:uncertaintyStatement ;
            sh:description "Optional uncertainty statements for measured, tested, calculated, or declared values used in this compliance statement" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path comp:statement_uncertainty_statements ],
        [ sh:datatype <xsd:string> ;
            sh:description "Standards this statement relates to" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:applicable_standards ],
        [ sh:datatype <xsd:string> ;
            sh:description "References to supporting tests" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:test_references ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for statement evidence, provenance, completeness, jurisdictional validity, or fitness for purpose" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path comp:statement_data_quality_assessments ],
        [ sh:description "Type of statement" ;
            sh:in ( "EMC" "SAFETY" "ENVIRONMENTAL" "RADIO" "CHEMICAL" "ENERGY" "PRIVACY" "ACCESSIBILITY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path comp:statement_type ],
        [ sh:datatype <xsd:string> ;
            sh:description "Content of the statement" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:statement_content ],
        [ sh:class mt:traceabilityStatement ;
            sh:description "Optional metrological traceability statements for tests, standards, methods, calibrations, or reference materials supporting this compliance statement" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path comp:statement_metrological_traceability_statements ] ;
    sh:targetClass comp:ComplianceStatement .

comp:ComplianceStatements a sh:NodeShape ;
    rdfs:comment "Container for compliance statements" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class comp:ComplianceStatement ;
            sh:description "Individual compliance statements" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path comp:statements ] ;
    sh:targetClass comp:ComplianceStatements .

comp:ComplianceStatus a sh:NodeShape ;
    rdfs:comment "Jurisdiction-specific compliance status for a commitment, allowing the same commitment to have different statuses in different markets." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:date> ;
            sh:description "Date when this status became effective" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:effective_date ],
        [ sh:datatype <xsd:string> ;
            sh:description "Authority that determined this status" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path comp:issuing_authority ],
        [ sh:datatype <xsd:string> ;
            sh:description "Additional notes or context about this status" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path comp:status_notes ],
        [ sh:description "Current status in this jurisdiction" ;
            sh:in ( "MANDATORY" "VOLUNTARY" "RECOMMENDED" "OPTIONAL" "NOT_APPLICABLE" "PENDING" "SUPERSEDED" "TRANSITIONAL" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path comp:status_value ],
        [ sh:datatype <xsd:date> ;
            sh:description "Date when this status expires or changes" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:expiry_date ],
        [ sh:datatype <xsd:string> ;
            sh:description "Jurisdiction or market where this status applies" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:jurisdiction ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for jurisdiction-specific status determinations, authority references, effective dates, or applicability evidence" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path comp:compliance_status_data_quality_assessments ] ;
    sh:targetClass comp:ComplianceStatus .

comp:DigitalSignature a sh:NodeShape ;
    rdfs:comment "Digital signature information for evidence authenticity" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Digital signature value or hash" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:signature_value ],
        [ sh:datatype <xsd:string> ;
            sh:description "Person or entity who signed" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:signatory ],
        [ sh:datatype <xsd:string> ;
            sh:description "Type of digital signature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:signature_type ],
        [ sh:datatype <xsd:string> ;
            sh:description "Reference to digital certificate" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path comp:certificate_reference ],
        [ sh:datatype <xsd:dateTime> ;
            sh:description "Date of digital signature" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:signature_date ] ;
    sh:targetClass comp:DigitalSignature .

comp:DocumentAccess a sh:NodeShape ;
    rdfs:comment "Information about document access and storage" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "URL where document can be accessed" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:document_url ],
        [ sh:datatype <xsd:string> ;
            sh:description "Any access restrictions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:access_restrictions ],
        [ sh:datatype <xsd:string> ;
            sh:description "Format of the document" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:document_format ],
        [ sh:datatype <xsd:string> ;
            sh:description "How long document must be retained" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:retention_period ],
        [ sh:datatype <xsd:string> ;
            sh:description "Where document is stored" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path comp:storage_location ],
        [ sh:datatype <xsd:string> ;
            sh:description "Checksum for integrity verification" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path comp:checksum ] ;
    sh:targetClass comp:DocumentAccess .

comp:EntityCommitments a sh:NodeShape ;
    rdfs:comment "Container for all commitments related to products or materials, providing a flexible framework for regulatory, voluntary, and contractual obligations that can evolve over time and vary by jurisdiction." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class comp:Commitment ;
            sh:description "List of individual commitments for products or materials" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path comp:commitments ] ;
    sh:targetClass comp:EntityCommitments .

comp:EntityEvidence a sh:NodeShape ;
    rdfs:comment "Container for all documentary evidence supporting compliance claims for products or materials, including declarations, certificates, test reports, and markings." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class comp:EvidenceDocument ;
            sh:description "List of evidence documents" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path comp:evidence_documents ] ;
    sh:targetClass comp:EntityEvidence .

comp:EvidenceDocument a sh:NodeShape ;
    rdfs:comment "A single piece of documentary evidence supporting compliance claims, with version tracking, digital signatures, and scope definition." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Conformity assessment procedure used" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path comp:conformity_assessment_procedure ],
        [ sh:datatype <xsd:string> ;
            sh:description "Title of the document" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:document_title ],
        [ sh:datatype <xsd:date> ;
            sh:description "Date when document was issued" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:issue_date ],
        [ sh:datatype <xsd:string> ;
            sh:description "Commitments that this evidence supports" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path comp:commitment_support ],
        [ sh:datatype <xsd:string> ;
            sh:description "Unique identifier for this document" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:document_identifier ],
        [ sh:class comp:ScopeOfEvidence ;
            sh:description "Scope covered by this evidence" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path comp:scope_of_evidence ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for evidence provenance, completeness, representativeness, document integrity, or fitness for purpose" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path comp:evidence_data_quality_assessments ],
        [ sh:class comp:ValidityPeriod ;
            sh:description "Validity period of this evidence" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path comp:validity_period ],
        [ sh:class comp:IssuingAuthority ;
            sh:description "Details about the issuing authority" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path comp:issuing_authority_details ],
        [ sh:class mt:traceabilityStatement ;
            sh:description "Optional metrological traceability statements for test methods, calibration chains, reference materials, measurement standards, or accredited procedures supporting this evidence document" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path comp:evidence_metrological_traceability_statements ],
        [ sh:description "Type of evidence document" ;
            sh:in ( "DECLARATION_OF_CONFORMITY" "CERTIFICATE" "TEST_REPORT" "INSPECTION_REPORT" "MARKING" "ATTESTATION" "TYPE_EXAMINATION" "APPROVAL" "TECHNICAL_FILE" "VERIFICATION" "MATERIAL_CERTIFICATE" "MATERIAL_DATASHEET" "SAFETY_DATA_SHEET" "GRADE_CERTIFICATE" "CHEMICAL_ANALYSIS" "ORIGIN_CERTIFICATE" "MATERIAL_PROPERTIES_TEST" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path comp:evidence_type ],
        [ sh:datatype <xsd:string> ;
            sh:description "Language(s) of the document" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path comp:document_language ],
        [ sh:class uq:uncertaintyStatement ;
            sh:description "Optional uncertainty statements for measured, tested, calculated, or declared values reported by this evidence document" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path comp:evidence_uncertainty_statements ],
        [ sh:class comp:DocumentAccess ;
            sh:description "Document access and storage information" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path comp:document_access ],
        [ sh:class comp:DigitalSignature ;
            sh:description "Digital signature information" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path comp:digital_signature ] ;
    sh:targetClass comp:EvidenceDocument .

comp:EvidenceReferences a sh:NodeShape ;
    rdfs:comment "References to evidence supporting a commitment" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "References to test reports" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:test_reports ],
        [ sh:datatype <xsd:string> ;
            sh:description "References to audit records" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:audit_records ],
        [ sh:datatype <xsd:string> ;
            sh:description "Links to relevant certifications" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:certification_links ],
        [ sh:datatype <xsd:string> ;
            sh:description "URIs or identifiers of supporting documents" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:supporting_documents ] ;
    sh:targetClass comp:EvidenceReferences .

comp:ImprovementTarget a sh:NodeShape ;
    rdfs:comment "An improvement target" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:float> ;
            sh:description "Target value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:target_value ],
        [ sh:datatype <xsd:string> ;
            sh:description "Description of target" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:target_description ],
        [ sh:datatype <xsd:date> ;
            sh:description "Target achievement date" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:target_date ] ;
    sh:targetClass comp:ImprovementTarget .

comp:IssuingAuthority a sh:NodeShape ;
    rdfs:comment "Details about the authority issuing evidence" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Unique identifier for the authority" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:authority_identifier ],
        [ sh:datatype <xsd:string> ;
            sh:description "Name of the issuing authority" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:authority_name ],
        [ sh:datatype <xsd:string> ;
            sh:description "Notified body number if applicable" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path comp:notified_body_number ],
        [ sh:description "Type of authority" ;
            sh:in ( "NOTIFIED_BODY" "CERTIFICATION_BODY" "TEST_LABORATORY" "INSPECTION_BODY" "MANUFACTURER" "AUTHORIZED_REPRESENTATIVE" "COMPETENT_AUTHORITY" "ACCREDITATION_BODY" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path comp:authority_type ],
        [ sh:datatype <xsd:string> ;
            sh:description "Country of the authority" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path comp:authority_country ],
        [ sh:datatype <xsd:string> ;
            sh:description "Accreditation information" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:accreditation_details ] ;
    sh:targetClass comp:IssuingAuthority .

comp:KeyPerformanceIndicator a sh:NodeShape ;
    rdfs:comment "A key performance indicator" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class mt:traceabilityStatement ;
            sh:description "Optional metrological traceability statements for KPI measurements, data sources, calculation chains, standards, or boundary definitions" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path comp:kpi_metrological_traceability_statements ],
        [ sh:datatype <xsd:float> ;
            sh:description "Current value" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:kpi_value ],
        [ sh:datatype <xsd:string> ;
            sh:description "Name of the KPI" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:kpi_name ],
        [ sh:class uq:uncertaintyStatement ;
            sh:description "Optional uncertainty statements for KPI values, aggregation methods, assumptions, or measurement variability" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path comp:kpi_uncertainty_statements ],
        [ sh:datatype <xsd:string> ;
            sh:description "Period of measurement" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:measurement_period ],
        [ sh:datatype <xsd:string> ;
            sh:description "Unit of measurement" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:kpi_unit ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for KPI data, provenance, completeness, representativeness, or fitness for compliance use" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path comp:kpi_data_quality_assessments ] ;
    sh:targetClass comp:KeyPerformanceIndicator .

comp:ManagementSystem a sh:NodeShape ;
    rdfs:comment "A management system certification or implementation with audit history and performance tracking." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class comp:CertificationDetails ;
            sh:description "Certification information" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path comp:certification_details ],
        [ sh:class comp:StandardReference ;
            sh:description "Reference to the standard" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path comp:standard_reference ],
        [ sh:datatype <xsd:string> ;
            sh:description "Scope of the management system" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path comp:scope_description ],
        [ sh:description "Type of management system" ;
            sh:in ( "QMS" "EMS" "OHS" "ISMS" "ENERGY" "CSR" "FSMS" "BCM" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path comp:system_type ],
        [ sh:class comp:AuditRecord ;
            sh:description "Audit history records" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path comp:audit_history ],
        [ sh:class comp:PerformanceMetrics ;
            sh:description "Performance metrics and targets" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path comp:performance_metrics ],
        [ sh:datatype <xsd:string> ;
            sh:description "Links to related commitments" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path comp:commitment_alignment ],
        [ sh:datatype <xsd:string> ;
            sh:description "References to certificates and reports" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path comp:evidence_documents ] ;
    sh:targetClass comp:ManagementSystem .

comp:PerformanceMetrics a sh:NodeShape ;
    rdfs:comment "Performance metrics and improvement targets" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class comp:KeyPerformanceIndicator ;
            sh:description "Key performance indicators" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path comp:kpis ],
        [ sh:class comp:ImprovementTarget ;
            sh:description "Improvement targets" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path comp:improvement_targets ] ;
    sh:targetClass comp:PerformanceMetrics .

comp:ProcessEvidence a sh:NodeShape ;
    rdfs:comment "Container for management system and process-related evidence demonstrating organizational compliance capabilities." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class comp:ManagementSystem ;
            sh:description "List of management systems" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path comp:management_systems ] ;
    sh:targetClass comp:ProcessEvidence .

comp:RegistrationNumber a sh:NodeShape ;
    rdfs:comment "A registration number" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Type of registration number" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:number_type ],
        [ sh:datatype <xsd:string> ;
            sh:description "The registration number" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:number_value ] ;
    sh:targetClass comp:RegistrationNumber .

comp:RegulatoryIdentifier a sh:NodeShape ;
    rdfs:comment "A market-specific regulatory identifier" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Scope where this identifier is valid" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:validity_scope ],
        [ sh:datatype <xsd:string> ;
            sh:description "Value of the identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:identifier_value ],
        [ sh:datatype <xsd:string> ;
            sh:description "Authority that issued this identifier" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:issuing_authority ],
        [ sh:datatype <xsd:string> ;
            sh:description "Type of identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:identifier_type ] ;
    sh:targetClass comp:RegulatoryIdentifier .

comp:RegulatoryIdentifiers a sh:NodeShape ;
    rdfs:comment "Container for regulatory identifiers" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class comp:RegulatoryIdentifier ;
            sh:description "Individual regulatory identifiers" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path comp:identifiers ] ;
    sh:targetClass comp:RegulatoryIdentifiers .

comp:RegulatoryInformation a sh:NodeShape ;
    rdfs:comment "Structured regulatory information including safety warnings, usage instructions, compliance statements, responsible parties, and regulatory identifiers." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class comp:RegulatoryIdentifiers ;
            sh:description "Market-specific regulatory identifiers" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path comp:regulatory_identifiers ],
        [ sh:class comp:UsageInstructions ;
            sh:description "Entity usage and maintenance instructions (for products or materials)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path comp:usage_instructions ],
        [ sh:class comp:ResponsibleParties ;
            sh:description "Responsible parties by jurisdiction" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path comp:responsible_parties ],
        [ sh:class comp:SafetyInformation ;
            sh:description "Safety warnings and instructions" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path comp:safety_information ],
        [ sh:class comp:ComplianceStatements ;
            sh:description "Regulatory compliance statements" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path comp:compliance_statements ] ;
    sh:targetClass comp:RegulatoryInformation .

comp:RequirementEntry a sh:NodeShape ;
    rdfs:comment "A single regulation, standard, or specification requirement with multi-jurisdictional applicability and version tracking." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Unique identifier for this requirement" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:requirement_identifier ],
        [ sh:datatype <xsd:string> ;
            sh:description "References to supporting evidence" ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path comp:compliance_evidence_links ],
        [ sh:datatype <xsd:string> ;
            sh:description "References to related commitments" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path comp:commitment_links ],
        [ sh:class comp:RequirementScope ;
            sh:description "Scope and applicability details" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path comp:requirement_scope ],
        [ sh:class comp:Amendment ;
            sh:description "History of amendments to this requirement" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path comp:amendment_history ],
        [ sh:datatype <xsd:string> ;
            sh:description "List of harmonized or equivalent standards" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path comp:harmonized_standards ],
        [ sh:datatype <xsd:string> ;
            sh:description "Authority that issued this requirement" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:issuing_authority ],
        [ sh:datatype <xsd:string> ;
            sh:description "Reference to newer requirement if this is superseded" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path comp:successor_reference ],
        [ sh:class comp:ApplicabilityStatus ;
            sh:description "Status of this requirement in different jurisdictions" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path comp:applicability_statuses ],
        [ sh:datatype <xsd:string> ;
            sh:description "Version or revision of the requirement" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path comp:version_value ],
        [ sh:datatype <xsd:date> ;
            sh:description "Date when this requirement was published" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path comp:publication_date ],
        [ sh:datatype <xsd:string> ;
            sh:description "Official title of the requirement" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:title_value ],
        [ sh:class dqf:dataQualityAssessment ;
            sh:description "Optional data quality assessments for regulatory source metadata, version tracking, jurisdictional applicability, or standards mapping" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path comp:requirement_data_quality_assessments ],
        [ sh:description "Type of requirement (regulation, standard, specification)" ;
            sh:in ( "REGULATION" "DIRECTIVE" "STANDARD" "SPECIFICATION" "GUIDELINE" "TECHNICAL_REPORT" "CODE_OF_PRACTICE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path comp:requirement_type ] ;
    sh:targetClass comp:RequirementEntry .

comp:RequirementScope a sh:NodeShape ;
    rdfs:comment "Defines the scope and applicability of a requirement" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Technical domains covered (EMC, safety, environmental, etc.)" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path comp:technical_domains ],
        [ sh:datatype <xsd:string> ;
            sh:description "Industry sectors where this applies" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path comp:industry_sectors ],
        [ sh:datatype <xsd:string> ;
            sh:description "Special conditions or limitations" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path comp:special_conditions ],
        [ sh:datatype <xsd:string> ;
            sh:description "Entity categories (product categories, material types) covered by this requirement" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path comp:entity_categories ],
        [ sh:datatype <xsd:string> ;
            sh:description "Specific exclusions from scope" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path comp:exclusions ] ;
    sh:targetClass comp:RequirementScope .

comp:ResponsibleParties a sh:NodeShape ;
    rdfs:comment "Container for responsible parties" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class comp:ResponsibleParty ;
            sh:description "Individual responsible party entries" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path comp:responsible_party_entries ] ;
